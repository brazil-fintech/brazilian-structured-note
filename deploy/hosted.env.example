# Copy to `.env` beside docker-compose.hosted.yml. Only COE_SQL_PASSWORD is required — every
# other value has a default and is here because it is worth knowing about. `.env` is ignored by
# git: the password belongs in the machine that runs the stack and in the repository's Actions
# secrets, not in the repository.

# Which published tag to run: latest, a release (v1.2.3) or a commit (sha-<40 hex>).
COE_TAG=latest

# SQL Server. COE_SQL_PASSWORD is the one value with no default and the one that must not be
# committed: on GitHub it is the Actions secret of the same name, and here it is generated once
# per machine —
#
#   echo "COE_SQL_PASSWORD=$(openssl rand -base64 24)aA1!" >> .env
#
COE_SQL_PASSWORD=
COE_SQL_PORT=1433
COE_DATABASE=Coe

# Where the app and the API are published on the host.
COE_WEB_PORT=8080
COE_API_PORT=5080

# The issuer short name written into the CETIP upload files when a certificate does not name one.
COE_PARTICIPANT_NAME=

# Off keeps the platform on the exports committed in the image, with no FTP call at all.
COE_CETIP_ENABLED=true

# The origin allowed to call the API from a browser. Set it to https://<owner>.github.io to
# use the GitHub Pages copy of the app against this API.
COE_WEB_ORIGIN=http://localhost:8080

# An OpenTelemetry collector to export traces and metrics to, e.g. http://otel-collector:4317.
COE_OTLP_ENDPOINT=
