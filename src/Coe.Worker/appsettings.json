{
  "ConnectionStrings": {
    "Coe": "Server=localhost,1433;Database=Coe;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Encrypt=True"
  },
  "Database": {
    "ApplyScriptsOnStartup": true,
    "ScriptDirectory": "../../../../../db",
    "MinPoolSize": 2,
    "MaxPoolSize": 20,
    "CommandTimeoutSeconds": 60,
    "MaxRetries": 4
  },
  "Clearing": {
    "ParticipantName": ""
  },
  "Cetip": {
    "Enabled": true,
    "Host": "ftp.cetip.com.br",
    "Port": 21,
    "Directory": "/Public",
    "User": "anonymous",
    "Password": "anonymous@",
    "UseSsl": false,
    "TimeoutSeconds": 60,
    "SyncOnStartup": true,
    "MinimumInterval": "06:00:00",
    "MaxLookbackDays": 10,
    "Exports": [],
    "LocalMirrorDirectory": null
  },
  "Ingestion": {
    "DomainDirectory": "../../../../../domain",
    "Interval": "00:05:00",
    "WatchFileSystem": true,
    "AutoEnableNewFigures": true,
    "DryRun": false,
    "ReferenceDirectory": "../../../../../reference/b3"
  },
  "Observability": {
    "OtlpEndpoint": null,
    "ConsoleExporter": false,
    "RecordSqlStatements": false,
    "TraceSampleRatio": 1.0
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
