{
  "figureCode": "COE001073",
  "figureName": "Call Alavancagens com Limitador",
  "commercialName": "Booster",
  "description": {
    "pt": "Alta alavancada com teto e queda um-para-um: resgate = VN × [1 + B × min(Perf, Cap)] na alta e VN × (1 + Perf) na baixa.",
    "en": "Leveraged capped upside with one-for-one downside: redemption = VN × [1 + B × min(Perf, Cap)] on the way up and VN × (1 + Perf) on the way down."
  },
  "modalities": [
    "VNR"
  ],
  "underlyingClasses": [
    "CAMBIO",
    "COMMODITIES",
    "ACOES",
    "INDICES",
    "ACOES_INT",
    "INDICES_INT",
    "CESTA"
  ],
  "extends": [
    "common/identification",
    "common/underlying",
    "common/remuneration",
    "common/settlement"
  ],
  "sections": [
    {
      "key": "payoff",
      "kind": "tab",
      "order": 30,
      "label": {
        "pt": "Payoff",
        "en": "Payoff"
      },
      "fields": [
        {
          "key": "strike",
          "order": 10,
          "label": {
            "pt": "Strike (% de S₀)",
            "en": "Strike (% of S₀)"
          },
          "dataType": "percent",
          "symbol": "K",
          "b3Field": "Strike",
          "required": true,
          "min": 0,
          "max": 1000,
          "decimals": 6,
          "default": 100,
          "help": {
            "pt": "Nível de performance a partir do qual a perna de opção começa a pagar; usualmente 100% de S₀.",
            "en": "The performance level from which the option leg starts paying; usually 100% of S₀."
          }
        },
        {
          "key": "leverage",
          "order": 20,
          "label": {
            "pt": "Alavancagem",
            "en": "Leverage"
          },
          "dataType": "decimal",
          "symbol": "B",
          "b3Field": "Alavancagem",
          "required": true,
          "min": 1,
          "max": 10,
          "decimals": 4,
          "default": 2,
          "help": {
            "pt": "Multiplicador aplicado à alta até o cap — 2 para um booster 2×.",
            "en": "Multiplier applied to the upside up to the cap — 2 for a 2× booster."
          }
        },
        {
          "key": "cap",
          "order": 30,
          "label": {
            "pt": "Limitador (%)",
            "en": "Cap (%)"
          },
          "dataType": "percent",
          "symbol": "Cap",
          "b3Field": "Limitador",
          "required": true,
          "min": 0,
          "max": 1000,
          "decimals": 6,
          "help": {
            "pt": "Performance máxima considerada pela fórmula.",
            "en": "Maximum performance considered by the formula."
          }
        },
        {
          "key": "downsideParticipation",
          "order": 40,
          "label": {
            "pt": "Participação na baixa (%)",
            "en": "Downside participation (%)"
          },
          "dataType": "percent",
          "required": true,
          "min": 0,
          "max": 1000,
          "decimals": 6,
          "default": 100
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "booster.modality",
      "targets": [
        "common.modality"
      ],
      "message": {
        "pt": "Esta figura é registrada na(s) modalidade(s) VNR.",
        "en": "This figure is registered under the VNR modality/modalities."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change",
      "assert": "modality in ['VNR']"
    },
    {
      "id": "booster.leverage-above-one",
      "targets": [
        "payoff.leverage"
      ],
      "message": {
        "pt": "Sem alavancagem maior que 1 a estrutura não é um booster.",
        "en": "Without leverage above 1 the structure is not a booster."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change",
      "assert": "leverage > 1"
    },
    {
      "id": "booster.cap-positive",
      "targets": [
        "payoff.cap"
      ],
      "message": {
        "pt": "O limitador deve ser maior que zero.",
        "en": "The cap must be greater than zero."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change",
      "assert": "cap > 0"
    },
    {
      "id": "booster.max-upside",
      "targets": [
        "payoff.cap"
      ],
      "message": {
        "pt": "Ganho máximo acima de 100% do valor nominal — confirme a estrutura com a mesa.",
        "en": "Maximum gain above 100% of nominal — confirm the structure with the desk."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "change",
      "assert": "leverage * cap <= 100"
    },
    {
      "id": "booster.downside-not-protected",
      "targets": [
        "common.guaranteedCapital"
      ],
      "message": {
        "pt": "O booster não protege a baixa: o capital garantido deve ser 0%.",
        "en": "A booster does not protect the downside: guaranteed capital must be 0%."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change",
      "assert": "guaranteedCapital == 0"
    }
  ]
}
