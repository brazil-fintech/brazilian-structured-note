  ],
  "rules": [
    {
      "id": "sharkfin.modality",
      "targets": [
        "common.modality"
      ],
      "message": {
        "pt": "Esta figura é registrada na(s) modalidade(s) VNP.",
        "en": "This figure is registered under the VNP modality/modalities."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change",
      "assert": "modality in ['VNP']"
    },
    {
      "id": "sharkfin.barrier-above-strike",
      "targets": [
        "barriers.barrierLevel"
      ],
      "message": {
        "pt": "A barreira de knock-out deve ficar acima do strike, senão a perna de alta nunca paga.",
        "en": "The knock-out barrier must sit above the strike, otherwise the upside leg never pays."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change",
      "assert": "barrierLevel > strike"
    },
    {
      "id": "sharkfin.rebate-below-max-payoff",
      "targets": [
        "payoff.rebate"
      ],
      "message": {
        "pt": "O rebate excede o ganho máximo antes do knock-out — o investidor prefere que a barreira seja atingida.",
        "en": "The rebate exceeds the maximum gain before knock-out — the investor is better off if the barrier is hit."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "change",
      "assert": "rebate <= participation * (barrierLevel - strike) / 100"
    },
    {
      "id": "sharkfin.tight-barrier",
      "targets": [
        "barriers.barrierLevel"
      ],
      "message": {
        "pt": "Barreira a menos de 10% acima do strike: a probabilidade de knock-out é alta.",
        "en": "Barrier less than 10% above the strike: the knock-out probability is high."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "change",
      "assert": "barrierLevel - strike >= 10"
    }
  ]
}
