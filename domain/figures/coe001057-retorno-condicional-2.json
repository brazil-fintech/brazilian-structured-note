  "rules": [
    {
      "id": "coe001057.remunerator-required",
      "targets": [
        "remuneration.maturityRemunerator"
      ],
      "assert": "maturityRemunerator != 'SEM_REMUNERACAO'",
      "message": {
        "pt": "O resgate desta figura é o principal acrescido de juros — sem remunerador não há retorno a apurar.",
        "en": "This figure redeems principal plus interest — with no remunerator there is nothing to accrue."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "coe001057.early-redemption-condition",
      "targets": [
        "terms.earlyRedemption"
      ],
      "assert": "earlyRedemption != 'SEM_LIQUIDEZ'",
      "message": {
        "pt": "O Caderno de Fórmulas descreve esta figura por dois cenários: com e sem resgate antecipado. Sem condição de liquidez, o segundo cenário nunca ocorre — confirme com a mesa.",
        "en": "The formula book describes this figure through two scenarios, with and without early redemption. With no liquidity condition the second never arises — confirm with the desk."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "change"
    }
  ]
