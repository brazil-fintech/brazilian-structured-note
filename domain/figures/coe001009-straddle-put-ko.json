  "rules": [
    {
      "id": "twinwin.modality",
      "targets": [
        "common.modality"
      ],
      "message": {
        "pt": "Esta figura é registrada na(s) modalidade(s) VNR.",
        "en": "This figure is registered under the VNR modality/modalities."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change",
      "assert": "modality in ['VNR']"
    },
    {
      "id": "twinwin.barrier-below-strike",
      "targets": [
        "barriers.barrierLevel"
      ],
      "message": {
        "pt": "A barreira de baixa deve ficar abaixo do strike.",
        "en": "The down barrier must sit below the strike."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change",
      "assert": "barrierLevel < strike"
    },
    {
      "id": "twinwin.participations-positive",
      "targets": [
        "payoff.upsideParticipation",
        "payoff.downsideParticipation"
      ],
      "message": {
        "pt": "As participações de alta e de baixa devem ser maiores que zero.",
        "en": "Both the upside and the downside participation must be greater than zero."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change",
      "assert": "upsideParticipation > 0 and downsideParticipation > 0"
    },
    {
      "id": "twinwin.asymmetric-participation",
      "targets": [
        "payoff.downsideParticipation"
      ],
      "message": {
        "pt": "Participações de alta e baixa diferentes — confirme que o DIE descreve o twin win assimétrico.",
        "en": "Upside and downside participations differ — confirm the DIE describes the asymmetric twin win."
      },
      "severity": "info",
      "execution": "client",
      "trigger": "change",
      "assert": "upsideParticipation == downsideParticipation"
    }
  ]
}
