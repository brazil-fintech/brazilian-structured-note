{
  "sections": [
    {
      "key": "barriers",
      "kind": "tab",
      "order": 35,
      "label": {
        "pt": "Barreiras",
        "en": "Barriers"
      },
      "help": {
        "pt": "A B3 registra a verificação como Europeia (uma Data para Fixing) ou Americana (verificação diária entre a Data Inicial e a Data Final, com tipo de cotação registrado). A escolha muda materialmente o risco e o preço.",
        "en": "B3 registers verification as European (a single fixing date) or American (daily verification between a start and an end date, with a registered quote type). The choice materially changes both risk and price."
      },
      "fields": [
        {
          "key": "barrierLevel",
          "order": 10,
          "label": {
            "pt": "Barreira (% de S₀)",
            "en": "Barrier (% of S₀)"
          },
          "symbol": "H",
          "dataType": "percent",
          "b3Field": "Barreira",
          "required": true,
          "min": 0,
          "max": 1000,
          "decimals": 8
        },
        {
          "key": "barrierDirection",
          "order": 20,
          "label": {
            "pt": "Direção da barreira",
            "en": "Barrier direction"
          },
          "dataType": "enum",
          "required": true,
          "options": [
            {
              "code": "ALTA",
              "label": {
                "pt": "Alta (up)",
                "en": "Up"
              }
            },
            {
              "code": "BAIXA",
              "label": {
                "pt": "Baixa (down)",
                "en": "Down"
              }
            }
          ]
        },
        {
          "key": "barrierType",
          "order": 30,
          "label": {
            "pt": "Tipo de barreira",
            "en": "Barrier type"
          },
          "dataType": "enum",
          "required": true,
          "options": [
            {
              "code": "KO",
              "label": {
                "pt": "Knock-out",
                "en": "Knock-out"
              },
              "help": {
                "pt": "Extingue a perna de opção.",
                "en": "Extinguishes the option leg."
              }
            },
            {
              "code": "KI",
              "label": {
                "pt": "Knock-in",
                "en": "Knock-in"
              },
              "help": {
                "pt": "Ativa a perna de opção.",
                "en": "Activates the option leg."
              }
            }
          ]
        },
        {
          "key": "verificationPeriod",
          "order": 40,
          "label": {
            "pt": "Período de Verificação de Barreiras",
            "en": "Barrier verification period"
          },
          "dataType": "enum",
          "b3Field": "Período de Verificação de Barreiras",
          "required": true,
          "default": "EUROPEIA",
          "options": [
            {
              "code": "AMERICANA",
              "b3Code": "10",
              "label": {
                "pt": "Americana",
                "en": "American"
              },
              "help": {
                "pt": "Verificação diária entre duas datas.",
                "en": "Daily verification between two dates."
              }
            },
            {
              "code": "EUROPEIA",
              "b3Code": "11",
              "label": {
                "pt": "Europeia",
                "en": "European"
              },
              "help": {
                "pt": "Uma única Data para Fixing.",
                "en": "A single fixing date."
              }
            }
          ],
          "help": {
            "pt": "Americana verifica a barreira em todos os dias do período; Europeia apenas na data de verificação. A B3 registra o campo com códigos próprios do COE (10 e 11), distintos dos do domínio de opções.",
            "en": "American checks the barrier on every day of the period; European only on the verification date. B3 registers the field under codes of its own for the COE (10 and 11), which are not those of the options domain."
          }
        },
        {
          "key": "barrierFixingDate",
          "order": 50,
          "label": {
            "pt": "Data para Fixing da barreira",
            "en": "Barrier fixing date"
          },
          "dataType": "date",
          "b3Field": "Data para Fixing",
          "visibleWhen": "verificationPeriod == 'EUROPEIA'",
          "requiredWhen": "verificationPeriod == 'EUROPEIA'"
        },
        {
          "key": "verificationStart",
          "order": 60,
          "label": {
            "pt": "Data Inicial para Verificação",
            "en": "Verification start date"
          },
          "dataType": "date",
          "b3Field": "Data Inicial para Verificação",
          "visibleWhen": "verificationPeriod == 'AMERICANA'",
          "requiredWhen": "verificationPeriod == 'AMERICANA'"
        },
        {
          "key": "verificationEnd",
          "order": 70,
          "label": {
            "pt": "Data Final para Verificação",
            "en": "Verification end date"
          },
          "dataType": "date",
          "b3Field": "Data Final para Verificação",
          "visibleWhen": "verificationPeriod == 'AMERICANA'",
          "requiredWhen": "verificationPeriod == 'AMERICANA'"
        },
        {
          "key": "verificationQuoteType",
          "order": 80,
          "label": {
            "pt": "Tipo de cotação da verificação",
            "en": "Verification quote type"
          },
          "dataType": "enum",
          "default": "FECHAMENTO",
          "visibleWhen": "verificationPeriod == 'AMERICANA'",
          "requiredWhen": "verificationPeriod == 'AMERICANA'",
          "options": [
            {
              "code": "FECHAMENTO",
              "label": {
                "pt": "Fechamento",
                "en": "Close"
              }
            },
            {
              "code": "MINIMO",
              "label": {
                "pt": "Mínimo",
                "en": "Low"
              }
            },
            {
              "code": "MAXIMO",
              "label": {
                "pt": "Máximo",
                "en": "High"
              }
            },
            {
              "code": "MEDIA",
              "label": {
                "pt": "Média",
                "en": "Average"
              }
            },
            {
              "code": "AJUSTE",
              "label": {
                "pt": "Ajuste",
                "en": "Settlement price"
              }
            }
          ],
          "help": {
            "pt": "Domínio registrado difere entre barreiras de KI e de KO; a figura define qual se aplica.",
            "en": "The registered domain differs between KI and KO barriers; the figure fixes which applies."
          }
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "barriers.verification-order",
      "targets": [
        "barriers.verificationEnd"
      ],
      "when": "verificationPeriod == 'AMERICANA'",
      "assert": "verificationEnd >= verificationStart",
      "message": {
        "pt": "A data final da verificação não pode ser anterior à inicial.",
        "en": "The verification end date cannot precede its start date."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "barriers.verification-within-tenor",
      "targets": [
        "barriers.verificationStart"
      ],
      "when": "verificationPeriod == 'AMERICANA'",
      "assert": "verificationStart >= common.issueDate and verificationEnd <= common.maturityDate",
      "message": {
        "pt": "A janela de verificação da barreira deve caber entre a emissão e o vencimento.",
        "en": "The barrier verification window must sit between the issue date and maturity."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "barriers.fixing-within-tenor",
      "targets": [
        "barriers.barrierFixingDate"
      ],
      "when": "verificationPeriod == 'EUROPEIA'",
      "assert": "barrierFixingDate > common.issueDate and barrierFixingDate <= common.maturityDate",
      "message": {
        "pt": "A Data para Fixing deve estar entre a emissão (exclusive) e o vencimento.",
        "en": "The fixing date must fall between the issue date (exclusive) and maturity."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "barriers.american-is-riskier",
      "targets": [
        "barriers.verificationPeriod"
      ],
      "when": "verificationPeriod == 'AMERICANA' and barrierType == 'KO'",
      "assert": "false",
      "message": {
        "pt": "Verificação americana: o knock-out ocorre em qualquer pregão da janela, mesmo que o ativo recue depois. Confirme que o DIE descreve essa convenção.",
        "en": "American verification: the knock-out fires on any trading day in the window, even if the underlying falls back afterwards. Confirm the DIE describes this convention."
      },
      "severity": "info",
      "execution": "client",
      "trigger": "change"
    }
  ]
}
