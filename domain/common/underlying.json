              "label": {
                "pt": "Worst of",
                "en": "Worst of"
              }
            },
            {
              "code": "STANDARD",
              "b3Code": "3",
              "label": {
                "pt": "Standard (ponderada)",
                "en": "Standard (weighted)"
              },
              "help": {
                "pt": "Pesos positivos somando 100%.",
                "en": "Positive weights summing to 100%."
              }
            },
            {
              "code": "SPREAD",
              "b3Code": "4",
              "label": {
                "pt": "Spread",
                "en": "Spread"
              }
            },
            {
              "code": "MEMORIZER",
