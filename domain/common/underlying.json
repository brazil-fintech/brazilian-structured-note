          "b3Field": "Valor Inicial Paridade",
          "decimals": 8,
          "min": 0,
          "visibleWhen": "assetClass == 'CESTA' and basketParityCurrency != 'BRL'",
          "requiredWhen": "assetClass == 'CESTA' and basketParityCurrency != 'BRL'"
        },
        {
          "key": "basketParityFixingDate",
          "order": 43,
          "label": {
            "pt": "Data Fixing da Paridade da Cesta",
            "en": "Basket parity fixing date"
          },
          "dataType": "date",
          "b3Field": "Data Fixing Paridade",
          "visibleWhen": "assetClass == 'CESTA' and basketParityCurrency != 'BRL'",
          "requiredWhen": "assetClass == 'CESTA' and basketParityCurrency != 'BRL'"
        },
        {
          "key": "fixingWindow",
          "order": 50,
          "label": {
            "pt": "Período de captura para liquidação",
            "en": "Final fixing capture"
          },
          "dataType": "enum",
          "b3Field": "Período de captura do ativo subjacente para liquidação",
          "required": true,
          "default": "DATA_UNICA",
          "options": [
            {
              "code": "DATA_UNICA",
              "label": {
                "pt": "Data Única",
                "en": "Single date"
              },
              "b3Code": "1"
            },
            {
              "code": "JANELA",
              "label": {
                "pt": "Janela de Datas",
                "en": "Date window"
              },
              "b3Code": "2"
            },
            {
              "code": "MAIS_DATAS",
              "label": {
                "pt": "Mais Datas",
                "en": "Explicit schedule"
              },
              "b3Code": "52"
            }
          ]
        },
        {
          "key": "fixingDate",
          "order": 55,
          "label": {
            "pt": "Data para fixing",
            "en": "Fixing date"
