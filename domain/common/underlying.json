            {
              "code": "RAINBOW",
              "b3Code": "6",
              "label": {
                "pt": "Rainbow",
                "en": "Rainbow"
              },
              "help": {
                "pt": "Pesos podem ser positivos, nulos ou negativos.",
                "en": "Weights may be positive, zero or negative."
              }
            },
            {
              "code": "HIMALAYAN",
              "b3Code": "7",
              "label": {
                "pt": "Himalayan",
                "en": "Himalayan"
              }
            },
            {
              "code": "DUAL_DIGITAL",
              "b3Code": "28",
              "label": {
                "pt": "Dual Digital",
                "en": "Dual Digital"
              }
            }
          ],
          "b3Domain": "TIPO CESTA"
        },
        {
          "key": "basketParityCurrency",
          "order": 41,
          "label": {
            "pt": "Moeda Paridade da Cesta",
            "en": "Basket parity currency"
          },
          "help": {
            "pt": "Moeda em que a cesta é apurada. Fora do real, a paridade inicial e a data de fixing da paridade passam a ser obrigatórias.",
            "en": "The currency the basket is struck in. Outside the real, the initial parity and its fixing date become mandatory."
          },
          "dataType": "enum",
          "b3Field": "Moeda Paridade",
          "visibleWhen": "assetClass == 'CESTA'",
          "requiredWhen": "assetClass == 'CESTA'",
          "default": "BRL",
          "options": [
            {
              "code": "BRL",
              "b3Code": "001",
              "label": {
                "pt": "Real",
                "en": "Brazilian real"
              }
            },
            {
              "code": "GBP",
              "b3Code": "002",
              "label": {
                "pt": "Libra esterlina",
                "en": "Pound sterling"
              }
            },
            {
              "code": "EUR",
              "b3Code": "003",
              "label": {
                "pt": "Euro",
                "en": "Euro"
              }
            },
            {
              "code": "JPY",
              "b3Code": "004",
              "label": {
                "pt": "Iene",
                "en": "Japanese yen"
              }
            },
            {
              "code": "USD",
              "b3Code": "005",
              "label": {
                "pt": "Dólar dos EUA",
                "en": "US dollar"
              }
            }
          ]
        },
