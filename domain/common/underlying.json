    {
      "id": "underlying.fixing-window-order",
      "targets": [
        "underlying.fixingWindowEnd"
      ],
      "when": "fixingWindow == 'JANELA'",
      "assert": "fixingWindowEnd >= fixingWindowStart",
      "message": {
        "pt": "A data final da janela de captura não pode ser anterior à data inicial.",
        "en": "The capture window's end date cannot precede its start date."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "underlying.registered-at-b3",
      "targets": [
        "underlying.asset"
      ],
      "when": "assetClass != 'CESTA' and notNull(asset)",
      "serverCheck": "underlyingRegistered",
      "args": {
        "path": "underlying.asset"
      },
      "message": {
        "pt": "Ativo subjacente não consta no cadastro da B3 para esta classe.",
        "en": "The underlying is not in B3's master for this asset class."
      },
      "severity": "error",
      "execution": "server",
      "trigger": "change"
    },
    {
      "id": "underlying.fixing-window-before-maturity",
      "targets": [
        "underlying.fixingWindowEnd"
      ],
      "when": "fixingWindow == 'JANELA'",
      "serverCheck": "businessDaysBefore",
      "args": {
        "path": "underlying.fixingWindowEnd",
        "referencePath": "common.maturityDate",
        "minimum": 0,
        "maximum": 5
      },
      "message": {
        "pt": "A janela de captura deve encerrar em até 5 dias úteis antes do vencimento.",
        "en": "The capture window must end no more than 5 business days before maturity."
      },
      "severity": "error",
      "execution": "server",
      "trigger": "change"
    },
    {
      "id": "underlying.fixing-window-length",
      "targets": [
        "underlying.fixingWindowStart"
      ],
      "when": "fixingWindow == 'JANELA'",
      "assert": "daysBetween(fixingWindowStart, fixingWindowEnd) <= 7",
      "message": {
        "pt": "A janela de captura registra de 1 a 5 dias úteis.",
        "en": "The capture window registers between 1 and 5 business days."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "underlying.lookback-order",
      "targets": [
        "underlying.lookbackEnd"
      ],
      "when": "hasLookback == true",
      "assert": "lookbackEnd > lookbackStart",
      "message": {
        "pt": "A data final do lookback deve ser posterior à inicial.",
        "en": "The lookback end date must be later than its start date."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "underlying.initial-value-recommended",
      "targets": [
        "underlying.initialValue"
      ],
      "when": "assetClass != 'CESTA' and hasLookback == false",
      "assert": "notNull(initialValue)",
      "message": {
        "pt": "Sem valor inicial informado, a B3 usa a cotação do dia útil anterior — só é aceito para ativos capturados.",
        "en": "With no initial value, B3 defaults to the previous business day's quote — accepted only for captured assets."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "basket.weights-sum-to-100",
      "targets": [
        "basket"
      ],
      "when": "underlying.assetClass == 'CESTA' and underlying.basketType == 'STANDARD'",
      "assert": "sum(basket, @.weight) == 100",
      "message": {
        "pt": "Os pesos de uma cesta ponderada devem somar 100%.",
        "en": "The weights of a weighted basket must sum to 100%."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "basket.weights-non-negative",
      "targets": [
        "basket"
      ],
      "when": "underlying.assetClass == 'CESTA' and underlying.basketType == 'STANDARD'",
      "assert": "all(basket, @.weight > 0)",
      "message": {
        "pt": "Pesos nulos ou negativos só são registráveis em cestas Rainbow.",
        "en": "Zero and negative weights are only registrable on a Rainbow basket."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "basket.components-distinct",
      "targets": [
        "basket"
      ],
      "when": "underlying.assetClass == 'CESTA'",
      "assert": "isDistinct(basket, @.component)",
      "message": {
        "pt": "Cada componente da cesta deve aparecer uma única vez.",
        "en": "Each basket component may appear only once."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "basket.weights-not-for-best-worst",
      "targets": [
        "basket"
      ],
      "when": "underlying.assetClass == 'CESTA' and underlying.basketType in ['WORST_OF', 'BEST_OF']",
      "assert": "all(basket, isNull(@.weight))",
      "message": {
        "pt": "Cestas Worst of e Best of não registram pesos: a apuração usa o pior ou o melhor componente.",
        "en": "Worst of and Best of baskets register no weights: settlement uses the worst or the best component."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "basket.fixing-within-tenor",
      "targets": [
        "basket"
      ],
      "when": "underlying.assetClass == 'CESTA'",
      "assert": "all(basket, isNull(@.componentFixingDate) or @.componentFixingDate <= common.maturityDate)",
      "message": {
        "pt": "A data de fixing de um componente não pode ser posterior ao vencimento.",
        "en": "A component's fixing date cannot fall after maturity."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "underlying.parity-dates-order",
      "targets": [
        "underlying.parityFixingDate"
      ],
      "when": "notNull(parityStartDate) and notNull(parityFixingDate)",
      "assert": "parityFixingDate >= parityStartDate",
      "message": {
        "pt": "A data de fixing da paridade não pode ser anterior à data inicial da paridade.",
        "en": "The parity fixing date cannot precede the parity start date."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "fixingDates.required-for-more-dates",
      "targets": [
        "underlying.fixingWindow"
      ],
      "when": "fixingWindow == 'MAIS_DATAS'",
      "assert": "count(fixingDates) > 0",
      "message": {
        "pt": "Um período de captura 'Mais Datas' exige a lista de datas de fixing.",
        "en": "A 'more dates' capture period needs its list of fixing dates."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "both"
    },
    {
      "id": "fixingDates.within-tenor",
      "forEachSection": "fixingDates",
      "targets": [
        "fixingDates[].fixingDate"
      ],
      "assert": "fixingDate > common.issueDate and fixingDate <= common.maturityDate",
      "message": {
        "pt": "As datas de fixing devem estar entre a emissão (exclusive) e o vencimento.",
        "en": "Fixing dates must fall between the issue date (exclusive) and maturity."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "fixingDates.distinct",
      "targets": [
        "fixingDates"
      ],
      "when": "underlying.fixingWindow == 'MAIS_DATAS'",
      "assert": "isDistinct(fixingDates, @.fixingDate)",
      "message": {
        "pt": "Há datas de fixing repetidas.",
        "en": "The fixing schedule repeats a date."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    }
  ]
}
