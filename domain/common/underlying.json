          "help": {
            "pt": "Data de captura da paridade para a liquidação. Não preencher para cestas.",
            "en": "The date the parity is captured for settlement. Not filled for baskets."
          },
          "dataType": "date",
          "b3Field": "Data Fixing Moeda Paridade Não Quanto",
          "visibleWhen": "quanto == false and assetClass != 'CESTA'"
        },
        {
          "key": "dividendProtection",
          "order": 160,
          "label": {
            "pt": "Proteção contra Proventos",
            "en": "Corporate-action protection"
          },
          "dataType": "enum",
          "b3Field": "Proteção contra Proventos",
          "visibleWhen": "assetClass in ['ACOES', 'ACOES INTERNACIONAIS']",
          "requiredWhen": "assetClass in ['ACOES', 'ACOES INTERNACIONAIS']",
          "options": [
            {
              "code": "EMISSOR",
              "label": {
                "pt": "Sim — Ajustado pelo Emissor",
                "en": "Yes — adjusted by the issuer"
              },
              "b3Code": "01"
            },
            {
              "code": "CETIP",
              "label": {
                "pt": "Sim — Cetip",
                "en": "Yes — Cetip"
              },
              "b3Code": "02"
            },
            {
              "code": "NAO",
              "label": {
                "pt": "Não",
                "en": "No"
              },
              "b3Code": "03"
            }
          ]
        }
      ]
    },
    {
