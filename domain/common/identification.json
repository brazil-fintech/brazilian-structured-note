{
  "sections": [
    {
      "key": "common",
      "kind": "common",
      "order": 0,
      "label": { "pt": "Dados gerais", "en": "General data" },
      "help": {
        "pt": "Campos da tela Registro/Emissão do Manual de Operações — COE. Sempre visíveis, qualquer que seja a figura.",
        "en": "Fields of the Registro/Emissão screen of the B3 Manual de Operações — COE. Always visible, whatever the figure."
      },
      "fields": [
        {
          "key": "issuerAccount",
          "order": 10,
          "label": { "pt": "Conta Emissora", "en": "Issuing account" },
          "help": {
            "pt": "Conta tipo 40 do emissor na B3. Somente bancos múltiplos, comerciais, de investimento, caixas econômicas e sociedades de crédito imobiliário podem emitir COE.",
            "en": "The issuer's type-40 account at B3. Only multiple, commercial, investment and savings banks may issue a COE."
          },
          "dataType": "string",
          "b3Field": "Conta Emissora",
          "required": true,
          "maxLength": 8,
          "inGrid": false
        },
        {
          "key": "commercialName",
          "order": 20,
          "label": { "pt": "Nome Fantasia", "en": "Commercial name" },
          "dataType": "string",
          "b3Field": "Nome Fantasia",
          "required": true,
          "maxLength": 100,
          "inGrid": true
        },
        {
          "key": "instrumentCode",
          "order": 30,
          "label": { "pt": "Código IF", "en": "Instrument code" },
          "help": {
            "pt": "Gerado pela B3 no formato MMFFAAMSSSS. Preenchido após o registro.",
            "en": "Generated by B3 as MMFFAAMSSSS. Filled in after registration."
          },
          "dataType": "string",
          "b3Field": "Código IF",
          "maxLength": 11,
          "enabledWhen": "false",
          "inGrid": true
        },
        {
          "key": "isin",
          "order": 40,
          "label": { "pt": "Código ISIN", "en": "ISIN code" },
          "dataType": "string",
          "b3Field": "Código ISIN",
          "maxLength": 12
        },
        {
          "key": "issueDate",
          "order": 50,
          "label": { "pt": "Data de Emissão", "en": "Issue date" },
          "help": {
            "pt": "Dia útil do calendário nacional em que o certificado é criado.",
            "en": "Business day of the national calendar on which the certificate is created."
          },
          "dataType": "date",
          "b3Field": "Data de Emissão",
          "required": true,
          "inGrid": true
        },
        {
          "key": "maturityDate",
          "order": 60,
          "label": { "pt": "Data de Vencimento", "en": "Maturity date" },
          "dataType": "date",
          "b3Field": "Data de Vencimento",
          "required": true,
          "inGrid": true
        },
        {
          "key": "quantity",
          "order": 70,
          "label": { "pt": "Quantidade Emitida", "en": "Quantity issued" },
          "dataType": "integer",
          "b3Field": "Quantidade Emitida",
          "required": true,
          "min": 1
        },
        {
          "key": "unitIssuePrice",
          "order": 80,
          "label": { "pt": "Valor Unitário de Emissão", "en": "Unit issue price" },
          "dataType": "money",
          "unit": "BRL",
          "b3Field": "Valor Unitário de Emissão",
          "required": true,
          "min": 0,
          "decimals": 8
        },
        {
          "key": "notional",
          "order": 90,
          "label": { "pt": "Valor Financeiro de Emissão (VFE)", "en": "Financial value of issuance (VFE)" },
          "help": {
            "pt": "Quantidade × Valor Unitário. Base dos campos registrados em percentual do VFE, como o rebate.",
            "en": "Quantity × unit price. The base of every amount registered as a percentage of the VFE, such as the rebate."
          },
          "dataType": "money",
          "unit": "BRL",
          "b3Field": "Valor Financeiro de Emissão",
          "computed": "quantity * unitIssuePrice",
          "inGrid": true
        },
        {
          "key": "modality",
          "order": 100,
          "label": { "pt": "Modalidade", "en": "Modality" },
          "dataType": "enum",
          "b3Field": "Modalidade",
          "required": true,
          "inGrid": true,
          "options": [
            {
              "code": "VNP",
              "label": { "pt": "Capital Investido Garantido (VNP)", "en": "Guaranteed invested capital (VNP)" },
              "help": {
                "pt": "Resgate no vencimento com piso no valor nominal investido.",
                "en": "Redemption at maturity floored at the invested nominal value."
              }
            },
            {
              "code": "VNR",
              "label": { "pt": "Perda Limitada ao Capital Investido (VNR)", "en": "Loss limited to invested capital (VNR)" },
              "help": {
                "pt": "O investidor pode perder até, mas nunca mais que, o valor nominal investido.",
                "en": "The investor can lose up to, but never more than, the invested nominal."
              }
            }
          ]
        },
        {
          "key": "guaranteedCapital",
          "order": 110,
          "label": { "pt": "Capital Garantido (%)", "en": "Guaranteed capital (%)" },
          "dataType": "percent",
          "b3Field": "Capital Garantido",
          "required": true,
          "min": 0,
          "max": 1000,
          "decimals": 4,
          "default": 100
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "common.maturity-after-issue",
      "targets": ["common.maturityDate"],
      "assert": "maturityDate > issueDate",
      "message": {
        "pt": "A Data de Vencimento deve ser posterior à Data de Emissão.",
        "en": "Maturity date must be later than the issue date."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "common.short-tenor",
      "targets": ["common.maturityDate"],
      "assert": "daysBetween(issueDate, maturityDate) >= 90",
      "message": {
        "pt": "Prazo inferior a 90 dias corridos — confirme com a mesa antes de registrar.",
        "en": "Tenor shorter than 90 calendar days — confirm with the desk before registering."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "common.vnp-guaranteed-capital",
      "targets": ["common.guaranteedCapital"],
      "when": "modality == 'VNP'",
      "assert": "guaranteedCapital >= 100",
      "message": {
        "pt": "Na modalidade Capital Investido Garantido o Capital Garantido deve ser de no mínimo 100%.",
        "en": "Under the guaranteed-capital modality, guaranteed capital must be at least 100%."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "common.vnr-guaranteed-capital",
      "targets": ["common.guaranteedCapital"],
      "when": "modality == 'VNR'",
      "assert": "guaranteedCapital >= 0 and guaranteedCapital < 100",
      "message": {
        "pt": "Na modalidade Perda Limitada o Capital Garantido deve ficar entre 0% e 100% (exclusive).",
        "en": "Under the limited-loss modality, guaranteed capital must sit between 0% and 100% (exclusive)."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "common.isin-length",
      "targets": ["common.isin"],
      "when": "notNull(isin)",
      "assert": "len(isin) == 12",
      "message": {
        "pt": "O código ISIN tem 12 caracteres.",
        "en": "An ISIN code has 12 characters."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "common.issue-date-business-day",
      "targets": ["common.issueDate"],
      "serverCheck": "businessDay",
      "args": { "path": "common.issueDate", "calendar": "BRASIL" },
      "message": {
        "pt": "A Data de Emissão deve ser dia útil no calendário nacional.",
        "en": "The issue date must be a business day on the national calendar."
      },
      "severity": "error",
      "execution": "server",
      "trigger": "change"
    },
    {
      "id": "common.maturity-date-business-day",
      "targets": ["common.maturityDate"],
      "serverCheck": "businessDay",
      "args": { "path": "common.maturityDate", "calendar": "BRASIL" },
      "message": {
        "pt": "A Data de Vencimento deve ser dia útil no calendário nacional.",
        "en": "The maturity date must be a business day on the national calendar."
      },
      "severity": "error",
      "execution": "server",
      "trigger": "change"
    },
    {
      "id": "common.instrument-code-unique",
      "targets": ["common.instrumentCode"],
      "when": "notNull(instrumentCode)",
      "serverCheck": "uniqueInstrumentCode",
      "args": { "path": "common.instrumentCode" },
      "message": {
        "pt": "Já existe um ativo registrado com este Código IF.",
        "en": "Another asset is already registered under this instrument code."
      },
      "severity": "error",
      "execution": "server",
      "trigger": "submit"
    }
  ]
}
