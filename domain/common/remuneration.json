              "b3Code": "03",
              "label": {
                "pt": "360 linear",
                "en": "360 linear"
              }
            }
          ]
        },
        {
          "key": "couponBarrierCondition",
          "order": 70,
          "label": {
            "pt": "Condicionante da Barreira de Cupom",
            "en": "Coupon barrier condition"
          },
          "help": {
            "pt": "Como a barreira de cupom é lida em cada evento. Deixe em branco quando o fluxo não tem barreira de cupom.",
            "en": "How the coupon barrier is read on each event. Leave blank when the schedule has no coupon barrier."
