          "dataType": "enum",
          "b3Field": "Condicionante Barreira de Chamada",
          "visibleWhen": "hasCashFlow == true",
          "options": [
            {
              "code": "ACIMA",
              "b3Code": "01",
              "label": {
                "pt": "Acima",
                "en": "Above"
              }
            },
            {
              "code": "ABAIXO",
              "b3Code": "02",
              "label": {
                "pt": "Abaixo",
                "en": "Below"
              }
            },
            {
              "code": "ENTRE",
              "b3Code": "03",
              "label": {
                "pt": "Entre",
                "en": "Between"
              },
              "help": {
                "pt": "Duas barreiras: o gatilho é a faixa entre elas.",
                "en": "Two barriers: the trigger is the band between them."
              }
            }
          ]
        },
        {
          "key": "flowCouponMemory",
          "order": 80,
          "label": {
            "pt": "Memória de Cupom no Fluxo",
