              },
              "help": {
                "pt": "Duas barreiras: o gatilho é a faixa entre elas.",
                "en": "Two barriers: the trigger is the band between them."
              }
            }
          ]
        },
        {
          "key": "callBarrierCondition",
          "order": 75,
          "label": {
            "pt": "Condicionante da Barreira de Chamada",
            "en": "Call barrier condition"
