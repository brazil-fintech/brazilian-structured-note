            "en": "Coupons missed because a barrier was not met accumulate and are released on the first event that meets it."
          },
          "dataType": "boolean",
          "b3Field": "Memória de Cupom",
          "visibleWhen": "hasCashFlow == true",
          "default": false
        }
      ]
    },
    {
      "key": "cashflows",
      "kind": "tab",
      "order": 25,
      "label": {
        "pt": "Fluxo de caixa",
        "en": "Cash flows"
      },
      "repeating": true,
      "minItems": 1,
      "maxItems": 999,
      "visibleWhen": "remuneration.hasCashFlow == true",
      "itemFields": [
        {
          "key": "paymentDate",
          "order": 10,
          "label": {
            "pt": "Data de Pagamento",
            "en": "Payment date"
          },
          "dataType": "date",
          "b3Field": "Datas de pagamento",
          "required": true
        },
        {
          "key": "flowRate",
          "order": 30,
          "label": {
            "pt": "Remunerador (%)",
            "en": "Floating remunerator (%)"
          },
          "dataType": "percent",
          "min": 0,
          "max": 9999,
          "decimals": 4,
          "visibleWhen": "remuneration.flowRemunerator in ['DI', 'IPCA_VCP', 'DI_VCP', 'USD_VCP', 'SOFR_VCP']",
          "requiredWhen": "remuneration.flowRemunerator in ['DI', 'IPCA_VCP']",
          "help": {
            "pt": "Percentual do indexador flutuante para este evento. Obrigatório para DI e IPCA VCP; não é preenchido para Pré e No Período.",
            "en": "The floating indexer percentage for this event. Mandatory for DI and IPCA VCP; not filled for fixed and period rates."
          }
        },
        {
          "key": "flowSpread",
          "order": 35,
          "label": {
            "pt": "Spread / Cupom (%)",
            "en": "Spread / coupon (%)"
          },
          "help": {
            "pt": "Cupom do evento. Obrigatório para Pré e No Período; opcional para DI e IPCA VCP.",
            "en": "The event's coupon. Mandatory for fixed and period rates; optional for DI and IPCA VCP."
          },
          "dataType": "percent",
          "b3Field": "Spread/Cupom",
          "decimals": 4,
          "min": 0,
          "max": 99999,
          "requiredWhen": "remuneration.flowRemunerator in ['PRE', 'NO_PERIODO']"
        },
        {
          "key": "amountPercent",
          "order": 40,
          "label": {
            "pt": "Pagamento (% do VFE)",
            "en": "Payment (% of VFE)"
          },
          "help": {
            "pt": "Percentual do Valor Financeiro de Emissão pago nesta data.",
            "en": "Percentage of the financial value of issuance paid on this date."
