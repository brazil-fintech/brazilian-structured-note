            "en": "The upper edge of the band when the condition is \"between\"."
          },
          "dataType": "percent",
          "b3Field": "Barreira Chamada 2",
          "decimals": 8,
          "min": 0,
          "max": 9999,
          "visibleWhen": "remuneration.callBarrierCondition == 'ENTRE'",
          "requiredWhen": "remuneration.callBarrierCondition == 'ENTRE'"
        },
        {
          "key": "couponBarrier",
          "order": 60,
          "label": {
