        "remuneration.floatingPercentage"
      ],
      "when": "maturityRemunerator == 'DI'",
      "assert": "floatingPercentage <= 130",
      "message": {
        "pt": "Percentual de CDI acima de 130% — confirme o funding com a tesouraria.",
        "en": "CDI percentage above 130% — confirm the funding with treasury."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "cashflows.payment-within-tenor",
      "forEachSection": "cashflows",
      "targets": [
        "cashflows[].paymentDate"
      ],
      "assert": "paymentDate > common.issueDate and paymentDate <= common.maturityDate",
      "message": {
        "pt": "Cada data de pagamento deve estar entre a emissão (exclusive) e o vencimento (inclusive).",
        "en": "Every payment date must fall between the issue date (exclusive) and maturity (inclusive)."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "cashflows.payment-business-day",
      "forEachSection": "cashflows",
      "targets": [
        "cashflows[].paymentDate"
      ],
      "serverCheck": "businessDay",
      "args": {
        "path": "paymentDate",
        "calendar": "BRASIL"
      },
      "message": {
        "pt": "As datas de pagamento devem ser dias úteis no calendário nacional.",
        "en": "Payment dates must be business days on the national calendar."
      },
      "severity": "error",
      "execution": "server",
      "trigger": "change"
    },
    {
      "id": "cashflows.dates-distinct",
      "targets": [
        "cashflows"
      ],
      "when": "remuneration.hasCashFlow == true",
      "assert": "isDistinct(cashflows, @.paymentDate)",
      "message": {
        "pt": "Há datas de pagamento repetidas no fluxo de caixa.",
        "en": "The cash-flow schedule repeats a payment date."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "cashflows.require-schedule",
      "targets": [
        "remuneration.hasCashFlow"
      ],
      "when": "remuneration.hasCashFlow == true",
      "assert": "count(cashflows) > 0",
      "message": {
        "pt": "Fluxo de Caixa marcado como Sim: informe ao menos um pagamento.",
        "en": "Cash flow is set to yes: register at least one payment."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "both"
    },
    {
      "id": "cashflows.no-schedule-without-flag",
      "targets": [
        "remuneration.hasCashFlow"
      ],
      "when": "remuneration.hasCashFlow == false",
      "assert": "count(cashflows) == 0",
      "message": {
        "pt": "Existem pagamentos registrados, mas o Fluxo de Caixa está marcado como Não.",
        "en": "Payments are registered while the cash-flow flag is set to no."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "both"
    },
    {
      "id": "cashflows.rate-not-for-fixed",
      "forEachSection": "cashflows",
      "targets": [
        "cashflows[].flowRate"
      ],
      "when": "remuneration.flowRemunerator in ['PRE', 'NO_PERIODO']",
      "assert": "isNull(flowRate)",
      "message": {
        "pt": "Um fluxo Pré ou No Período não registra percentual de remunerador flutuante.",
        "en": "A fixed or period-rate schedule registers no floating remunerator percentage."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "cashflows.fixing-without-barrier",
      "forEachSection": "cashflows",
      "targets": [
        "cashflows[].fixingDate"
      ],
      "when": "isNull(remuneration.couponBarrierCondition) and isNull(remuneration.callBarrierCondition)",
      "assert": "isNull(fixingDate)",
      "message": {
        "pt": "A data de fixing só é registrada quando o evento tem barreira de cupom e/ou de chamada.",
        "en": "The fixing date is only registered when the event has a coupon and/or call barrier."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "cashflows.fixing-within-tenor",
      "forEachSection": "cashflows",
      "targets": [
        "cashflows[].fixingDate"
      ],
      "when": "notNull(fixingDate)",
      "assert": "fixingDate > common.issueDate and fixingDate <= common.maturityDate",
      "message": {
        "pt": "A data de fixing do evento deve estar entre a emissão (exclusive) e o vencimento.",
        "en": "The event's fixing date must fall between the issue date (exclusive) and maturity."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "cashflows.fixing-order",
      "forEachSection": "cashflows",
      "targets": [
        "cashflows[].fixingDate2"
      ],
      "when": "notNull(fixingDate2) and notNull(fixingDate)",
      "assert": "fixingDate2 >= fixingDate",
      "message": {
        "pt": "A segunda data de fixing encerra o período de apuração e não pode ser anterior à primeira.",
        "en": "The second fixing date closes the observation period and cannot precede the first."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "cashflows.fixing-before-payment",
      "forEachSection": "cashflows",
      "targets": [
        "cashflows[].fixingDate"
      ],
      "when": "notNull(fixingDate)",
      "assert": "fixingDate <= paymentDate",
      "message": {
        "pt": "A barreira é verificada antes de o evento pagar: a data de fixing não pode ser posterior à data de pagamento.",
        "en": "A barrier is checked before its event pays: the fixing date cannot fall after the payment date."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "cashflows.coupon-barrier-band",
      "forEachSection": "cashflows",
      "targets": [
        "cashflows[].couponBarrier2"
      ],
      "when": "remuneration.couponBarrierCondition == 'ENTRE' and notNull(couponBarrier) and notNull(couponBarrier2)",
      "assert": "couponBarrier2 > couponBarrier",
      "message": {
        "pt": "Na condicionante \"Entre\", a segunda barreira de cupom é o limite superior da faixa.",
        "en": "Under the \"between\" condition, the second coupon barrier is the upper edge of the band."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "cashflows.call-barrier-band",
      "forEachSection": "cashflows",
      "targets": [
        "cashflows[].callBarrier2"
      ],
      "when": "remuneration.callBarrierCondition == 'ENTRE' and notNull(callBarrier) and notNull(callBarrier2)",
      "assert": "callBarrier2 > callBarrier",
      "message": {
        "pt": "Na condicionante \"Entre\", a segunda barreira de chamada é o limite superior da faixa.",
        "en": "Under the \"between\" condition, the second call barrier is the upper edge of the band."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "remuneration.memory-needs-coupon-barrier",
      "targets": [
        "remuneration.flowCouponMemory"
      ],
      "when": "flowCouponMemory == true",
      "assert": "notNull(couponBarrierCondition)",
      "message": {
        "pt": "Memória de cupom acumula cupons que uma barreira impediu de pagar; sem barreira de cupom, não há o que acumular.",
        "en": "Coupon memory accumulates coupons a barrier stopped from paying; with no coupon barrier there is nothing to accumulate."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "both"
    },
    {
      "id": "remuneration.flow-basis-for-di-or-pre",
      "targets": [
        "remuneration.flowBasis"
      ],
      "when": "hasCashFlow == true and flowRemunerator in ['DI', 'PRE']",
      "assert": "notNull(flowBasis)",
      "message": {
        "pt": "A base do fluxo é obrigatória quando o remunerador do fluxo é DI ou Pré.",
        "en": "The cash-flow day-count basis is mandatory when the flow remunerator is DI or fixed."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "both"
    }
  ]
}
