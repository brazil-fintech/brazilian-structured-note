            {
              "code": "MEDIA_PERIODO",
              "b3Code": "01",
              "label": {
                "pt": "Média no período",
                "en": "Average over the period"
              }
            },
            {
              "code": "DATA_A_DATA",
              "b3Code": "02",
              "label": {
                "pt": "Verificação data a data",
                "en": "Date-by-date verification"
              }
            },
            {
              "code": "MAXIMO_PERIODO",
              "b3Code": "03",
              "label": {
                "pt": "Máximo do período",
                "en": "Maximum over the period"
              }
            },
            {
              "code": "MINIMO_PERIODO",
              "b3Code": "04",
              "label": {
                "pt": "Mínimo do período",
                "en": "Minimum over the period"
              }
            }
          ]
        },
        {
          "key": "fixingDate2",
          "order": 80,
          "label": {
            "pt": "Data de Fixing 2",
            "en": "Fixing date 2"
