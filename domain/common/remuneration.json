          "dataType": "percent",
          "b3Field": "Barreira Cupom",
          "decimals": 8,
          "min": 0,
          "max": 9999,
          "visibleWhen": "notNull(remuneration.couponBarrierCondition)",
          "requiredWhen": "notNull(remuneration.couponBarrierCondition)"
        },
        {
          "key": "couponBarrier2",
          "order": 65,
          "label": {
            "pt": "Barreira de Cupom 2 (%)",
            "en": "Coupon barrier 2 (%)"
          },
          "help": {
            "pt": "Limite superior da faixa quando a condicionante é \"Entre\".",
            "en": "The upper edge of the band when the condition is \"between\"."
          },
          "dataType": "percent",
          "b3Field": "Barreira Cupom 2",
          "decimals": 8,
          "min": 0,
          "max": 9999,
          "visibleWhen": "remuneration.couponBarrierCondition == 'ENTRE'",
          "requiredWhen": "remuneration.couponBarrierCondition == 'ENTRE'"
        },
        {
