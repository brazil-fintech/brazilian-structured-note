{
  "sections": [
    {
      "key": "autocall",
      "kind": "tab",
      "order": 40,
      "label": { "pt": "Resgate antecipado automático", "en": "Autocall" },
      "help": {
        "pt": "O autocall não é uma figura própria: é a figura registrada mais o Fluxo de Caixa e o disparo comandado pela função Indicação de Disparo de Trigger.",
        "en": "An autocall is not a figure of its own: it is the registered figure plus the cash-flow schedule and the trigger commanded through the Indicação de Disparo de Trigger function."
      },
      "fields": [
        {
          "key": "hasAutocall",
          "order": 10,
          "label": { "pt": "Possui autocall", "en": "Has autocall" },
          "dataType": "boolean",
          "required": true,
          "default": false
        },
        {
          "key": "triggerType",
          "order": 20,
          "label": { "pt": "Tipo de trigger", "en": "Trigger type" },
          "dataType": "enum",
          "default": "FIXO",
          "visibleWhen": "hasAutocall == true",
          "requiredWhen": "hasAutocall == true",
          "options": [
            { "code": "FIXO", "label": { "pt": "Fixo", "en": "Flat" } },
            { "code": "STEP_DOWN", "label": { "pt": "Step-down", "en": "Step-down" } },
            { "code": "STEP_UP", "label": { "pt": "Step-up", "en": "Step-up" } }
          ]
        },
        {
          "key": "paymentTiming",
          "order": 30,
          "label": { "pt": "Período de Pagamento", "en": "Payment timing" },
          "help": {
            "pt": "Ato liquida no momento do disparo; Vencimento marca o evento e paga no vencimento.",
            "en": "Ato settles the moment the trigger fires; Vencimento marks the event and pays at maturity."
          },
          "dataType": "enum",
          "b3Field": "Período de Pagamento",
          "default": "ATO",
          "visibleWhen": "hasAutocall == true",
          "requiredWhen": "hasAutocall == true",
          "options": [
            { "code": "ATO", "label": { "pt": "Ato", "en": "On trigger" } },
            { "code": "VENCIMENTO", "label": { "pt": "Vencimento", "en": "At maturity" } }
          ]
        },
        {
          "key": "couponMemory",
          "order": 40,
          "label": { "pt": "Memória de cupom", "en": "Coupon memory" },
          "help": {
            "pt": "Cupons não pagos em datas anteriores são recuperados na primeira data em que a condição verifica.",
            "en": "Coupons missed on earlier dates are recovered on the first date the condition verifies."
          },
          "dataType": "boolean",
          "default": false,
          "visibleWhen": "hasAutocall == true"
        }
      ]
    },
    {
      "key": "observations",
      "kind": "tab",
      "order": 45,
      "label": { "pt": "Datas de observação", "en": "Observation dates" },
      "repeating": true,
      "minItems": 1,
      "maxItems": 120,
      "visibleWhen": "autocall.hasAutocall == true",
      "itemFields": [
        {
          "key": "observationDate",
          "order": 10,
          "label": { "pt": "Data de observação", "en": "Observation date" },
          "symbol": "t_i",
          "dataType": "date",
          "required": true
        },
        {
          "key": "triggerLevel",
          "order": 20,
          "label": { "pt": "Trigger de autocall (% de S₀)", "en": "Autocall trigger (% of S₀)" },
          "symbol": "T_i",
          "dataType": "percent",
          "required": true,
          "min": 0,
          "max": 1000,
          "decimals": 6,
          "default": 100
        },
        {
          "key": "couponBarrier",
          "order": 30,
          "label": { "pt": "Barreira de cupom (% de S₀)", "en": "Coupon barrier (% of S₀)" },
          "symbol": "H_c",
          "dataType": "percent",
          "min": 0,
          "max": 1000,
          "decimals": 6
        },
        {
          "key": "observationCoupon",
          "order": 40,
          "label": { "pt": "Cupom da observação (%)", "en": "Observation coupon (%)" },
          "symbol": "C",
          "dataType": "percent",
          "min": 0,
          "max": 1000,
          "decimals": 6
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "autocall.requires-observations",
      "targets": ["autocall.hasAutocall"],
      "when": "hasAutocall == true",
      "assert": "count(observations) > 0",
      "message": {
        "pt": "Informe ao menos uma data de observação para o autocall.",
        "en": "Register at least one observation date for the autocall."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "both"
    },
    {
      "id": "observations.within-tenor",
      "forEachSection": "observations",
      "targets": ["observations[].observationDate"],
      "assert": "observationDate > common.issueDate and observationDate <= common.maturityDate",
      "message": {
        "pt": "As datas de observação devem estar entre a emissão (exclusive) e o vencimento.",
        "en": "Observation dates must fall between the issue date (exclusive) and maturity."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "observations.dates-distinct",
      "targets": ["observations"],
      "when": "autocall.hasAutocall == true",
      "assert": "isDistinct(observations, @.observationDate)",
      "message": {
        "pt": "Há datas de observação repetidas.",
        "en": "The observation schedule repeats a date."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "observations.coupon-needs-barrier",
      "forEachSection": "observations",
      "targets": ["observations[].couponBarrier"],
      "when": "notNull(observationCoupon) and observationCoupon > 0",
      "assert": "notNull(couponBarrier)",
      "message": {
        "pt": "Um cupom de observação exige a barreira de cupom que o condiciona.",
        "en": "An observation coupon needs the coupon barrier that conditions it."
      },
      "severity": "error",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "observations.coupon-barrier-below-trigger",
      "forEachSection": "observations",
      "targets": ["observations[].couponBarrier"],
      "when": "notNull(couponBarrier)",
      "assert": "couponBarrier <= triggerLevel",
      "message": {
        "pt": "A barreira de cupom acima do trigger nunca paga cupom sem disparar o resgate.",
        "en": "A coupon barrier above the trigger never pays a coupon without also redeeming the note."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "change"
    },
    {
      "id": "autocall.memory-needs-coupons",
      "targets": ["autocall.couponMemory"],
      "when": "couponMemory == true",
      "assert": "any(observations, @.observationCoupon > 0)",
      "message": {
        "pt": "Memória de cupom sem nenhum cupom de observação não tem efeito.",
        "en": "Coupon memory has no effect when no observation pays a coupon."
      },
      "severity": "warning",
      "execution": "both",
      "trigger": "both"
    }
  ]
}
